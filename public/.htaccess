# ============================================================
# NOC Dashboard — Apache konfiguracija (SPA + keširanje)
# ============================================================
# Fajl se automatski kopira u dist/ pri `npm run build`
# jer se nalazi u public/ folderu (Vite publicDir).
#
# ŠTA RADI:
#  1. SPA fallback — sve putanje koje nisu fajl/direktorijum
#     i nisu /api/* preusmerava na index.html (da rade refresh i
#     direktni linkovi bez 404).
#  2. Keširanje — hasheovani assets (vite build) kešira 1 godinu,
#     index.html nikad (da update odmah bude vidljiv).
#  3. Sigurnosni headeri.
#
# NAPOMENA: Proxy /api -> backend (http://localhost:8080) NE MOŽE
# u .htaccess — mora u glavnu Apache konfiguraciju / VirtualHost.
# Vidi: apache/nos-dashboard.conf
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Ako je sajt u podfolderu (npr. /nos-dashboard/), promeni u:
  # RewriteBase /nos-dashboard/
  RewriteBase /

  # Ne diraj /api/* — to hendla ProxyPass u vhost-u
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^/metrics [OR]
  RewriteCond %{REQUEST_URI} ^/health
  RewriteRule ^ - [L]

  # Ako fajl/direktorijum postoji na disku — serviraj ga direktno
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sve ostalo -> index.html (SPA routing)
  RewriteRule ^ index.html [L]
</IfModule>

# ——— Keširanje ———
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML nikad ne keširaj (da novi build odmah proradi)
  ExpiresByType text/html "access plus 0 seconds"
  # Hasheovani JS/CSS/slike — 1 godina
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # index.html — uvek sveže
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Hasheovani fajlovi — dugi keš (ime se menja kad se sadržaj menja)
  <FilesMatch "\-[a-f0-9]{8}\.(js|css|png|jpg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Sigurnosni headeri
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ——— Kompresija ———
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
