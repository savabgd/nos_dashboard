# ============================================================
# Produkcija — Apache (Vite build)
# ============================================================
# KORISĆENJE:
#   1. Kopiraj / prilagodi i builduj:
#        npm run build                # root: http://server/
#        # ili za podfolder:
#        npm run build:apache:subfolder  # http://server/nos-dashboard/
#
#   2. Za Apache proxy (preporučeno) — ostavi prazno ili "/" :
#      Browser zove /api/* na ISTOM originu, Apache prosleđuje
#      na backend (nema CORS). Vidi apache/nos-dashboard.conf.
#
#   3. Za direktan poziv backend-a (bez proxy, npr. drugi host):
#      VITE_API_BASE_URL=http://10.20.30.40:8080
#
# Napomena: fajl se čita SAMO pri `vite build`, ne u runtime-u.

# Prazno = relative (isti origin) → ide preko Apache ProxyPass
VITE_API_BASE_URL=

# Ako deployuješ u podfolder, otkomentariši:
# VITE_BASE_PATH=/nos-dashboard/

VITE_SSE_ENABLED=true
VITE_SSE_INTERVAL=30
VITE_AUTO_REFRESH_INTERVAL=300000
