# VoLTE KPI Dashboard - Environment Variables
# ================================================
# Copy this file to .env and configure as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
API_TITLE=VoLTE KPI API
API_VERSION=1.0.0
API_DESCRIPTION=REST API for VoLTE KPI monitoring and analysis

# CORS Configuration (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ClickHouse Database Configuration
CH_HOST=localhost
CH_PORT=8123
CH_USER=default
CH_PASSWORD=
CH_DATABASE=volte_kpi
CH_TIMEOUT=30

# Redis Cache Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300

# SLA Thresholds (configurable)
SLA_ACCESS_FAIL_RATE=2.0
SLA_DROP_RATE=1.5
SLA_CELL_INTEGRITY=97.0
SLA_PDCCH_ERROR=3.0
SLA_ERLANG_PER_SECTOR=40.0

# Authentication (optional)
# Set AUTH_ENABLED=true and provide a secret key for API authentication
AUTH_ENABLED=false
AUTH_SECRET=change-me-in-production
AUTH_ALGORITHM=HS256

# Rate Limiting
RATE_LIMIT=100/minute

# Alert Notifications (optional)
# When enabled, new alerts are POSTed to an external webhook (Slack, OpsGenie, etc.)
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
NOTIFY_WEBHOOK_TIMEOUT=5

# Monitoring / Metrics
# Exposes Prometheus-format metrics at /metrics
METRICS_ENABLED=true

# Frontend Configuration
# The URL where the API is running (for the dashboard to connect)
VITE_API_BASE_URL=http://localhost:8080

# Auto-refresh interval in milliseconds (default: 300000 = 5 minutes)
VITE_AUTO_REFRESH_INTERVAL=300000

# Real-time updates via Server-Sent Events
# When enabled (default), the dashboard subscribes to /api/kpis/stream
VITE_SSE_ENABLED=true
# SSE push interval in seconds (default: 30)
VITE_SSE_INTERVAL=30

# UI theme: 'dark' | 'light' | 'system' (default follows the OS setting)
VITE_THEME=system
